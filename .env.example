# Kopiraj u .env.local i zameni vrednostima iz Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Samo server — nikad u browser (Stripe webhook, admin, bootstrap agencije)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# OpenAI — server-only; koristi se za RAG embeddings i audio transkripciju
OPENAI_API_KEY=sk-proj-...

# Model za AI asistenta (/agencija/asistent) i njegovo pozivanje alata.
# Podrazumevano gpt-4o. gpt-4o-mini je jeftiniji ali slabije bira pravi alat
# kada pitanje nije jednoznačno.
OPENAI_AGENT_MODEL=gpt-4o

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Šest Stripe Price ID (mesečno + godišnje za svaki plan). UI povlači iznose iz Stripe API-ja.
# Na svakoj ceni u Dashboardu: metadata plan_tier = agency_basic | agency_l | agency_xl
STRIPE_PRICE_AGENCY_BASIC_MONTHLY=price_...
STRIPE_PRICE_AGENCY_BASIC_YEARLY=price_...
STRIPE_PRICE_AGENCY_L_MONTHLY=price_...
STRIPE_PRICE_AGENCY_L_YEARLY=price_...
STRIPE_PRICE_AGENCY_XL_MONTHLY=price_...
STRIPE_PRICE_AGENCY_XL_YEARLY=price_...

# Opciono: javni URL aplikacije (npr. za produkciju)
# NEXT_PUBLIC_APP_URL=https://tvoj-domen.com

# Offline-first (Phase 2)
NEXT_PUBLIC_ENABLE_OFFLINE=true
# Jezik za lokalni OCR (tesseract). "sr" → srp_latn+srp (latinica + ćirilica).
# Override npr. srp_latn | srp | eng | srp_latn+eng
NEXT_PUBLIC_OCR_LANGUAGE=sr
# Interval automatskog sync-a u milisekundama
NEXT_PUBLIC_SYNC_INTERVAL=5000

# SaaS pretplata: kada je "true", upis/sync zahteva aktivnu pretplatu (402 ako nije).
# Postavi na "true" pre javnog SaaS lansiranja; "false" ili izostavljeno = provera isključena.
REQUIRE_ACTIVE_SUBSCRIPTION=false

# Vercel Cron / ručni trigger za dnevne compliance notifikacije.
# Authorization: Bearer <CRON_SECRET>  ili  ?secret=<CRON_SECRET>
# Generiši jak random string (npr. openssl rand -hex 32).
CRON_SECRET=
