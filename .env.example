# Kopiraj u .env.local i zameni vrednostima iz Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Samo server — nikad u browser (Stripe webhook, admin, bootstrap agencije)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Šest Stripe Price ID (mesečno + godišnje za svaki plan). UI povlači iznose iz Stripe API-ja.
# Na svakoj ceni u Dashboardu: metadata plan_tier = agency_basic | agency_l | agency_xl
STRIPE_PRICE_AGENCY_BASIC_MONTHLY=price_...
STRIPE_PRICE_AGENCY_BASIC_YEARLY=price_...
STRIPE_PRICE_AGENCY_L_MONTHLY=price_...
STRIPE_PRICE_AGENCY_L_YEARLY=price_...
STRIPE_PRICE_AGENCY_XL_MONTHLY=price_...
STRIPE_PRICE_AGENCY_XL_YEARLY=price_...

# Opciono: javni URL aplikacije (npr. za produkciju)
# NEXT_PUBLIC_APP_URL=https://tvoj-domen.com
